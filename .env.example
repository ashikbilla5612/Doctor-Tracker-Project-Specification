# PORT: Server listening port (defaults to 3000)
PORT="3000"

# AUTH_SECRET: Signing secret for HMAC-SHA256 authentication tokens
AUTH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"

# ADMIN_EMAIL / ADMIN_PASSWORD: Initial seeded administrator account
ADMIN_EMAIL="admin@doctortracker.org"
ADMIN_PASSWORD="MY_INITIAL_ADMIN_PASSWORD"

# DB_FILE_PATH: Path to persistent indexed datastore JSON file
DB_FILE_PATH="./data/doctor-tracker.json"

# GEMINI_API_KEY: Required if optional AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
